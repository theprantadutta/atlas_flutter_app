# This project builds with CocoaPods, NOT Swift Package Manager.
#
# Under SPM the dependency graph has no solution: firebase_messaging wants
# firebase-ios-sdk 13.x, which needs gtm-session-fetcher 4.x, while
# google_sign_in_ios wants googlesignin-ios 9.x, and every 9.x release needs
# gtm-session-fetcher 3.x. No published google_sign_in avoids it, and the
# Firebase plugins are already at their latest, so there is no version pair
# that resolves. Until google_sign_in_ios supports gtm-session-fetcher 4.x,
# iOS has to go through CocoaPods:
#
#   flutter config --no-enable-swift-package-manager
#
# That flag is global to the Flutter install rather than per project, so a
# fresh machine (where SPM is on by default) will fail at pod resolution until
# it is set.
#
# CocoaPods then needs its own fix: firebase_core asks for Firebase iOS SDK
# 12.19.3, a patch that was never published to the CocoaPods trunk, which
# stops at 12.19.0. CocoaPods reports that as "specs repository is too
# out-of-date", which is misleading; pod repo update cannot help because the
# version does not exist there. firebase_core reads this override, so pin the
# newest version that is actually published as a pod.
#
# Note Firebase is deprecating CocoaPods: no new versions after October 2026.
# This arrangement has a shelf life.
$FirebaseSDKVersion = '12.19.0'

# Uncomment this line to define a global platform for your project
# platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
