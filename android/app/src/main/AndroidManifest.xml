<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Put scheduled reminders back after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Hold the mic to talk to Aurora (speech to text). Asked for only when
         the user first presses the mic. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Reminders (habits, tasks, the morning note, the weekly letter,
         Aurora's "Remind me") are scheduled on the device, inexactly
         (AndroidScheduleMode.inexactAllowWhileIdle), so no alarm permission is
         needed: a habit tracker is not an alarm clock. Both exact alarm
         permissions are stripped so a dependency cannot merge them back in.
         The server only pushes account messages over FCM. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />

    <application
        android:label="Atlas"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Delivers the reminders scheduled above. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Restores them after a reboot or an app update. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- FCM background notifications: the spark silhouette, tinted coral. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_atlas" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/atlas_notification" />
        <!-- Server pushes are account messages: they belong on that channel,
             not FCM's generic "Miscellaneous" one. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="atlas_account" />
        <!-- Screens are reported by route from the app; the automatic
             activity-based report would only ever say "MainActivity". -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <!-- Reading Aurora's letter aloud (flutter_tts) and voice input
             (speech_to_text) need to see the system engines on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
